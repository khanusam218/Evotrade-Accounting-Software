# ── Database ──────────────────────────────────────────────────────────────
# Option A: discrete vars, for a local Postgres install
DB_HOST=localhost
DB_PORT=5432
DB_NAME=evotrade
DB_USER=postgres
DB_PASSWORD=your_password

# Option B: a single connection string (e.g. Neon, Supabase, or any managed
# Postgres). If DATABASE_URL is set, it takes priority over the DB_* vars
# above and connects over SSL automatically.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── App ───────────────────────────────────────────────────────────────────
PORT=3001
JWT_SECRET=replace_with_a_long_random_string
CORS_ORIGIN=http://localhost:5173
